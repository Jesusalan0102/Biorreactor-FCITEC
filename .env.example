# Copia este archivo como ".env" en la misma carpeta que controlfisicoV2.py
# y rellena los valores reales. El archivo ".env" NUNCA debe subirse a git
# (ya está listado en .gitignore).

# --- Base de datos MySQL (Clever Cloud) ---
DB_HOST=tu-host-mysql.services.clever-cloud.com
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_de_datos
DB_PORT=3306

# --- Clave maestra para activar el panel de administración ---
CLAVE_MAESTRA=cambia-esta-clave
