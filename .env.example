# Copia este archivo como ".env" en la misma carpeta que controlfisicoV2.py
# y rellena los valores reales. El archivo ".env" NUNCA debe subirse a git
# (ya está listado en .gitignore).

# --- Base de datos MySQL (ejemplo con TiDB Cloud; sirve cualquier MySQL) ---
# Los datos salen del botón "Connect" de tu cluster. DB_NAME es TU base (p. ej. biorreactor),
# no "sys". Copia el usuario con el botón de copiar (lleva un prefijo y termina en .root).
DB_HOST=gatewayXX.region.prod.aws.tidbcloud.com
DB_USER=prefijo.root
DB_PASSWORD=tu_password
DB_NAME=biorreactor
DB_PORT=4000

# --- Clave maestra para activar el panel de administración ---
CLAVE_MAESTRA=cambia-esta-clave

# --- SSL (solo si tu proveedor de MySQL lo exige: Aiven, TiDB Cloud, etc.) ---
# TiDB Cloud exige TLS. El certificado raíz (isrgrootx1.pem) ya viene en este repositorio:
# una ruta relativa se busca junto al script (en web/ para el SCADA web).
DB_SSL_CA=isrgrootx1.pem
# Alternativa sin certificado (cifrada, pero no verifica al servidor):
# DB_SSL=true
